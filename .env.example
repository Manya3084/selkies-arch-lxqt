# Desktop login password (required)
PASSWD=changeme

# Host port mapped to Selkies (default 3020)
HOST_PORT=3020

# GPU render node inside the container
DRI_NODE=/dev/dri/renderD128

# --- Intel Arc (default) ---
# A750=8086:56a1  A770=8086:56a0  A580=8086:56a2  B580=8086:e20b
MESA_VK_DEVICE_SELECT=8086:56a1
VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/intel_icd.json

# --- AMD (Mesa RADV) — uncomment and set your PCI ID from: lspci -nn ---
# MESA_VK_DEVICE_SELECT=1002:744c
# VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/radeon_icd.x86_64.json

# --- NVIDIA — needs host driver + nvidia-container-toolkit; see README ---
# Also set NVIDIA_VISIBLE_DEVICES / deploy.resources (or runtime: nvidia) in compose
# MESA_VK_DEVICE_SELECT=10de:2684
# VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json
